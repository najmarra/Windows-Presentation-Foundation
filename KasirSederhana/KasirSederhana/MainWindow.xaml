<Window x:Class="KasirSederhana.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Simple Cashier"
        Height="680"
        Width="920"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="30">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="1.3*"/>
        </Grid.ColumnDefinitions>

        <!-- ===================== FORM INPUT ===================== -->
        <StackPanel Grid.Column="0">
            <TextBlock Text="SIMPLE CASHIER"
                       FontSize="24"
                       FontWeight="Bold"
                       Margin="0,0,0,20"/>

            <TextBlock Text="Pilih Produk"/>
            <ComboBox x:Name="cmbProduk"
                      Height="35"
                      Margin="0,5,0,10"
                      SelectionChanged="CmbProduk_SelectionChanged"/>

            <TextBlock Text="Harga Satuan"/>
            <TextBlock x:Name="txtHarga"
                       Text="-"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Margin="0,5,0,10"/>

            <TextBlock Text="Jumlah"/>
            <TextBox x:Name="txtQty"
                     Height="35"
                     Margin="0,5,0,15"
                     Text="1"/>

            <StackPanel Orientation="Horizontal">
                <Button Content="Tambah"
                        Width="120"
                        Height="40"
                        Margin="0,0,10,0"
                        Click="BtnTambah_Click"/>
                <Button Content="Reset"
                        Width="120"
                        Height="40"
                        Click="BtnReset_Click"/>
            </StackPanel>
        </StackPanel>

        <!-- ===================== KERANJANG & PEMBAYARAN ===================== -->
        <StackPanel Grid.Column="2">
            <TextBlock Text="KERANJANG BELANJA"
                       FontSize="24"
                       FontWeight="Bold"
                       Margin="0,0,0,20"/>

            <ListBox x:Name="lstKeranjang"
                     Height="200"/>

            <Button Content="Hapus Item"
                    Width="120"
                    Height="35"
                    Margin="0,10,0,10"
                    HorizontalAlignment="Left"
                    Click="BtnHapus_Click"/>

            <CheckBox x:Name="chkMember"
                      Content="Member (diskon 10%)"
                      Margin="0,0,0,10"
                      Checked="ChkMember_Changed"
                      Unchecked="ChkMember_Changed"/>

            <TextBlock x:Name="txtJumlahItem" Text="Jumlah Item: 0"/>
            <TextBlock x:Name="txtSubtotal" Text="Subtotal: Rp 0" Margin="0,3,0,0"/>
            <TextBlock x:Name="txtDiskon" Text="Diskon: Rp 0" Margin="0,3,0,0"/>
            <TextBlock x:Name="txtTotal"
                       Text="TOTAL: Rp 0"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0,8,0,12"/>

            <TextBlock Text="Metode Pembayaran"/>
            <StackPanel Orientation="Horizontal" Margin="0,5,0,10">
                <RadioButton x:Name="rbTunai"
                             Content="Tunai"
                             Margin="0,0,20,0"
                             Checked="Metode_Changed"/>
                <RadioButton x:Name="rbQris"
                             Content="QRIS"
                             Checked="Metode_Changed"/>
            </StackPanel>

            <TextBlock Text="Uang Diterima (khusus Tunai)"/>
            <TextBox x:Name="txtBayar"
                     Height="35"
                     Margin="0,5,0,12"/>

            <Button Content="BAYAR"
                    Width="150"
                    Height="42"
                    HorizontalAlignment="Left"
                    FontWeight="Bold"
                    Click="BtnBayar_Click"/>
        </StackPanel>
    </Grid>
</Window>
